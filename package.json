{
  "name": "chainsentry",
  "version": "0.1.0",
  "description": "Detect crypto giveaway scams: link safety, wallet money-flow analysis, and refund verification.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "CS_E2E=1 vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "d3": "^7.9.0",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.268",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.19.43",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
